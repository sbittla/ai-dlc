{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.example/specs/001-escalation-rules/contracts/escalation-rules.schema.json",
  "title": "Escalation rules: rule, evaluation and rejection documents",
  "x-spec": "ESC-SPEC-1",
  "x-spec-version": "1.0.0",
  "$defs": {
    "Rule": {
      "type": "object",
      "required": ["rule_id", "project_id", "priority", "steps"],
      "additionalProperties": false,
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "project_id": {"type": "integer", "minimum": 1},
        "priority": {"type": "string", "enum": ["P1", "P2", "P3", "P4"], "x-relay-constant": "PRIORITIES"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Step"}}
      }
    },
    "Step": {
      "type": "object",
      "required": ["number", "delay_minutes", "targets"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "delay_minutes": {"type": "integer", "minimum": 5, "maximum": 240},
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "Evaluation": {
      "type": "object",
      "required": ["spec_version", "task_id", "rule_id", "evaluated_at", "status", "fire", "next_due_at"],
      "additionalProperties": false,
      "properties": {
        "spec_version": {"type": "string", "const": "1.0.0"},
        "task_id": {"type": "integer", "minimum": 1},
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "evaluated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "status": {"type": "string", "enum": ["not_applicable", "acknowledged", "active", "complete"],
                   "x-relay-constant": "STATUSES"},
        "fire": {"type": "array", "items": {"$ref": "#/$defs/StepDecision"}},
        "next_due_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "StepDecision": {
      "type": "object",
      "required": ["step", "targets", "due_at"],
      "additionalProperties": false,
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "due_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "Rejection": {
      "type": "object",
      "required": ["code", "message", "subject"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "x-relay-constant": "ERROR_CODES",
                 "enum": ["not_rule_editor", "unsupported_priority", "no_steps", "steps_not_numbered",
                          "delay_out_of_range", "delays_not_increasing", "no_targets", "target_not_user",
                          "target_not_in_workspace", "target_cannot_view_project"]},
        "message": {"type": "string"},
        "subject": {"type": ["string", "null"]}
      }
    }
  }
}
