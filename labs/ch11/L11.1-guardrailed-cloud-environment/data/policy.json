{
 "policy_version": "cloud-policy-v1",
 "as_of_default": "2026-11-30",
 "rules": {
  "POL001": {
   "severity": "high",
   "title": "No ingress from the internet"
  },
  "POL002": {
   "severity": "high",
   "title": "No public data endpoint"
  },
  "POL003": {
   "severity": "high",
   "title": "No public compute or public model endpoint"
  },
  "POL004": {
   "severity": "high",
   "title": "Model calls go through a private endpoint with a restrictive policy"
  },
  "POL005": {
   "severity": "high",
   "title": "Storage encrypted with a customer-managed key"
  },
  "POL006": {
   "severity": "medium",
   "title": "Required tags present and valid"
  },
  "POL007": {
   "severity": "high",
   "title": "No wildcard IAM in identity policies"
  },
  "POL008": {
   "severity": "high",
   "title": "No long-lived credentials; CI federation pinned to one repository"
  },
  "POL009": {
   "severity": "high",
   "title": "A budget with actual and forecast alerts, within the environment's ceiling"
  },
  "POL010": {
   "severity": "high",
   "title": "No egress to the internet except allowlisted"
  },
  "POL011": {
   "severity": "medium",
   "title": "Database protected: deletion protection, backups, final snapshot, standby"
  },
  "POL012": {
   "severity": "high",
   "title": "Only approved regions and instance sizes"
  }
 },
 "required_tags": [
  "app",
  "env",
  "owner",
  "cost-center",
  "data-class"
 ],
 "allowed_env": [
  "prod",
  "nonprod",
  "lab",
  "sandbox"
 ],
 "expires_required_for_env": [
  "lab",
  "sandbox"
 ],
 "data_classes": [
  "Public",
  "Internal",
  "Confidential",
  "Restricted"
 ],
 "max_data_class_outside_prod": "Internal",
 "allowed_regions": [
  "us-east-1",
  "us-west-2"
 ],
 "allowed_instance_types": [
  "t4g.*",
  "m7g.large",
  "m7g.xlarge"
 ],
 "allowed_db_classes": [
  "db.t4g.*",
  "db.m7g.large"
 ],
 "egress_allowlist": [
  {
   "security_group": "aws_security_group.egress_proxy",
   "ports": [
    443
   ],
   "reason": "Allowlisting proxy for agent sandboxes (ADR-013)"
  }
 ],
 "internet_route_tables": [
  "aws_route_table.egress",
  "aws_route_table.public"
 ],
 "wildcard_resource_actions": [
  "ecr:GetAuthorizationToken"
 ],
 "admin_managed_policies": [
  "arn:aws:iam::aws:policy/AdministratorAccess",
  "arn:aws:iam::aws:policy/PowerUserAccess",
  "arn:aws:iam::aws:policy/IAMFullAccess"
 ],
 "budget_ceiling_usd": {
  "nonprod": 500,
  "lab": 100,
  "sandbox": 100
 },
 "min_backup_retention_days": 7,
 "multi_az_required_for_env": [
  "nonprod",
  "prod"
 ],
 "model_endpoint_services": [
  "bedrock-runtime"
 ],
 "model_actions_prefix": "bedrock:Invoke",
 "oidc": {
  "host": "token.actions.githubusercontent.com",
  "audience": "sts.amazonaws.com"
 },
 "waivers": [
  {
   "id": "W-001",
   "rule": "POL007",
   "address": "aws_iam_role_policy.ci_apply",
   "owner": "sam.o",
   "expires": "2027-02-26",
   "reason": "The apply role creates and deletes every resource type in this configuration. It is assumable only from the protected nonprod environment after a reviewer approves, and IAM actions are limited to this environment's roles. Narrow it from CloudTrail's record of the actions it used in its first month."
  }
 ]
}
