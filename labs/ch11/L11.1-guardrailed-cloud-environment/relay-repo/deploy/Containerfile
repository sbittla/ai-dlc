# Relay 4.21.0 container image (ADR-015). One image for the service and the worker;
# the worker's task definition overrides the entry point. Build from the repository root:
#
#   docker build -f deploy/Containerfile -t relay:4.21.0 .
#
# The base image is pinned by tag. Digest pinning, signing and an SBOM arrive with
# the supply-chain work (Chapter 13), as for the dev container's image (waiver WS023).
FROM python:3.12-slim

COPY deploy/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY src/ /app/src/
ENV PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# A numeric, unprivileged user; the task definition also makes the root filesystem
# read-only and drops every Linux capability.
USER 10001
EXPOSE 8080
ENTRYPOINT ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--access-logfile", "-", \
            "relay.service.wsgi:application"]
