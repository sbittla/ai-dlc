  "claims": [
    {
      "id": "C0",
      "text": "The maintenance bot cannot make a harmful change reach users without a person's approval, and a harmful change that is approved is rolled back."
    },
    {
      "argument": "Triage reads structured fields only; the step's tools are four, reading taints the run, and code the bot did not write runs in the sandbox.",
      "evidence": [
        "E04",
        "E08",
        "E13",
        "E14"
      ],
      "id": "C1",
      "parent": "C0",
      "text": "Untrusted input cannot steer the bot outside its task."
    },
    {
      "argument": "The write list and the proposal desk refuse protected paths; the App cannot touch workflows.",
      "evidence": [
        "E01",
        "E02",
        "E03",
        "E11"
      ],
      "id": "C2",
      "parent": "C0",
      "text": "The bot cannot change its own instructions, workflow, policy or code."
    },
    {
      "argument": "No such tool exists; approvals need a person's proof and an independent owner; an approval binds the diff and the evidence.",
