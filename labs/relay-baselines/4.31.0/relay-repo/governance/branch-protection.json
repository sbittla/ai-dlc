{
  "branch": "main",
  "required_status_checks": {"strict": true, "contexts": ["tests", "secret-scan", "supply-chain", "security-gates",
                                                      "pr-check", "triage-eval", "coverage-gate", "pipeline-guard"]},
  "required_pull_request_reviews": {
    "required_approving_review_count": 1,
    "require_code_owner_reviews": true,
    "dismiss_stale_reviews": true,
    "require_last_push_approval": true
  },
  "enforce_admins": {"enabled": true},
  "restrictions": {"users": [], "teams": ["maintainers"], "apps": []},
  "required_merge_queue": {"enabled": true, "note": "required checks run again on merge_group, after approvals"},
  "allow_force_pushes": {"enabled": false},
  "allow_deletions": {"enabled": false}
}
