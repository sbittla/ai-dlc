{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay escalation rules API",
    "version": "1.1.0",
    "description": "Routes for escalation rules and a task's escalation (spec ESC-SPEC-1 1.1.0, behaviour B7; ADR-009). Request and response bodies reference the JSON Schema contract next to this file.",
    "x-spec": "ESC-SPEC-1",
    "x-spec-version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local development (python -m relay.service --demo)"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/projects/{pid}/escalation-rules": {
      "get": {
        "operationId": "listRules",
        "summary": "A project's escalation rules (Owner, Admin, Member)",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The project's rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "rules"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "$ref": "escalation-rules.schema.json#/$defs/Rule"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{pid}/escalation-rules/{rid}": {
      "get": {
        "operationId": "getRule",
        "summary": "One rule (Owner, Admin, Member)",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "escalation-rules.schema.json#/$defs/Rule"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putRule",
        "summary": "Create or replace a rule (Owner, Admin); validated on the server and audited",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "escalation-rules.schema.json#/$defs/Rule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "escalation-rules.schema.json#/$defs/Rule"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "escalation-rules.schema.json#/$defs/Rule"
                }
              }
            }
          },
          "400": {
            "description": "Body is not valid JSON, is nested too deeply, or does not match the contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body over 16,384 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The rule ID is used by a rule in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Refused by validate_rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "escalation-rules.schema.json#/$defs/Rejection"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{pid}/tasks/{tid}/escalation": {
      "get": {
        "operationId": "getEscalation",
        "summary": "The task's escalation panel (anyone who can view the project)",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The panel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscalationView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{pid}/tasks/{tid}/priority": {
      "post": {
        "operationId": "setPriority",
        "summary": "A person sets or confirms the priority (Owner, Admin, Member)",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The panel after the change",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscalationView"
                }
              }
            }
          },
          "400": {
            "description": "Body is not valid JSON, is nested too deeply, or does not match the contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body over 16,384 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{pid}/tasks/{tid}/acknowledge": {
      "post": {
        "operationId": "acknowledge",
        "summary": "A person acknowledges the task (anyone who can view the project)",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The panel after the acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscalationView"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The caller's role or project visibility does not allow this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown project, rule or task, or a task in another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Over 600 requests per minute for this token; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PriorityRequest": {
        "type": "object",
        "required": [
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          }
        }
      },
      "EscalationView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "priority",
          "priority_set_at",
          "priority_set_by",
          "suggestion",
          "acknowledged_at",
          "acknowledged_by",
          "activity"
        ],
        "properties": {
          "task_id": {
            "type": "integer"
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority_set_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority_set_by": {
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          },
          "acknowledged_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "acknowledged_by": {
            "type": [
              "integer",
              "null"
            ]
          },
          "activity": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
