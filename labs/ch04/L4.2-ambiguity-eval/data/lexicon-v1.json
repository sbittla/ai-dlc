{
  "lexicon_version": "detector-lexicon-v1",
  "note": "Carried over from Lab 4.1's lexicon, plus a first list of quality words and actor terms.",
  "vague_terms": [
    "adequate",
    "and/or",
    "appropriate",
    "as needed",
    "easy",
    "efficient",
    "etc.",
    "fast",
    "flexible",
    "intuitive",
