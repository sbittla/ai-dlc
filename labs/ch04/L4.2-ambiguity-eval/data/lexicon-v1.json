  "passive_pattern": "(?i)\\b(is|are|be|been|being|was|were)\\s+(\\w+ed|sent|shown|kept|done|made|given|taken|seen|written|run|set|built|held)\\b",
  "contradiction": {
    "min_overlap": 0.5,
    "min_overlap_polarity": 0.6
  }
}
