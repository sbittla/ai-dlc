    "reasonable",
    "relevant",
    "right people",
    "robust",
    "seamless",
    "secure",
    "simple",
    "timely",
    "urgent",
    "user-friendly"
  ],
  "weak_modals": [
    "should",
    "may",
    "might",
    "could",
    "ideally",
    "where possible",
    "if possible",
    "try to"
  ],
  "quality_terms": [
    "available",
    "reliable",
    "reliably",
    "secure"
  ],
  "measurable_patterns": [
    "\\$\\d",
    "\\b\\d+(\\.\\d+)?\\s*(%|(ms|milliseconds?|seconds?|minutes?|hours?|business hours|days?|KB|MB)\\b)",
    "\\b(at most|at least|no more than|up to) \\d+",
    "\\bWCAG \\d\\.\\d\\b",
    "\\bmust not\\b"
